{
  "id": "data-lens",
  "name": "Data Lens",
  "defaultLocale": "en",
  "subtitle": "Charts from chat data files",
  "author": "咕咕",
  "version": "0.1.0",
  "apiVersion": 26,
  "platforms": [
    "desktop",
    "phone"
  ],
  "engines": {
    "gugu": ">=0.3.1"
  },
  "entry": "card.html",
  "icon": "icon.png",
  "permissions": {
    "capabilities": [
      "files:read",
      "agents:tools"
    ]
  },
  "contributes": {
    "tabs": [
      {
        "name": "card",
        "title": "Data Lens",
        "icon": "icon.png",
        "entry": "card.html",
        "widget": {
          "height": 360
        }
      },
      {
        "name": "explore",
        "title": "Data Lens",
        "icon": "icon.png",
        "entry": "explore.html",
        "opensFiles": {
          "chat": [".csv", ".tsv", ".xlsx", ".xls", ".ods", ".sqlite", ".sqlite3", ".db"]
        }
      }
    ],
    "mcpServers": [
      {
        "tools": "tools.js"
      }
    ],
    "skills": "skills",
    "instructions": "Read skill data-lens to chart a chat's .csv/.xlsx/.sqlite file: data_schema, data_query, data_card, then widget_send view card."
  },
  "license": "MIT",
  "localized": {
    "zh-CN": {
      "name": "数据透视",
      "subtitle": "把群里的数据文件变成图表和表格",
      "tabs": {
        "card": { "title": "数据透视" },
        "explore": { "title": "数据透视" }
      }
    }
  }
}
