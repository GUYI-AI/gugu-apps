{
  "id": "radar",
  "name": "雷达",
  "defaultLocale": "zh-CN",
  "subtitle": "关注 agent 的运行状态",
  "author": "咕咕",
  "version": "0.3.0",
  "apiVersion": 24,
  "platforms": [
    "desktop"
  ],
  "engines": {
    "gugu": ">=0.3.1"
  },
  "entry": "radar.html",
  "icon": "icon.png",
  "background": {
    "entry": "background.html"
  },
  "permissions": {
    "capabilities": [
      "agents:read:all-machines",
      "agents:control:all-machines",
      "agents:history:all",
      "agents:tools"
    ],
    "network": []
  },
  "contributes": {
    "tabs": [
      {
        "name": "radar",
        "title": "雷达",
        "entry": "radar.html"
      }
    ],
    "mcpServers": [
      {
        "tools": "tools.js"
      }
    ],
    "instructions": "radar__watch(target, level, notify) alerts when an agent errs, needs a person or finishes; unwatch and watching manage watches."
  },
  "license": "MIT",
  "localized": {
    "en": {
      "name": "Radar",
      "subtitle": "Watch agents and get alerts"
    }
  }
