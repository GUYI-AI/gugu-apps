{
  "id": "omnisearch",
  "name": "全能搜索",
  "defaultLocale": "zh-CN",
  "subtitle": "agent 的网页与文档搜索",
  "author": "咕咕",
  "version": "0.3.0",
  "apiVersion": 24,
  "platforms": [
    "desktop"
  ],
  "engines": {
    "gugu": ">=0.3.1"
  },
  "entry": "settings.html",
  "icon": "icon.png",
  "permissions": {
    "capabilities": [
      "agents:tools"
    ]
  },
  "contributes": {
    "tabs": [
      {
        "name": "settings",
        "title": "全能搜索",
        "entry": "settings.html",
        "icon": "icon.png"
      }
    ],
    "mcpServers": [
      {
        "name": "omnisearch",
        "command": "node",
        "args": [
          "launch.mjs"
        ]
      }
    ],
    "instructions": "omnisearch__* tools: web search, read a page, library docs, cited answers and GitHub search, for the services that have a key."
  },
  "localized": {
    "en": {
      "name": "Omnisearch",
      "subtitle": "Web and docs search for agents"
    }
  }
}
