{
  "id": "omnisearch",
  "name": "全能搜索",
  "description": "给 agent 的搜索工具：网页搜索、读网页、查编程库文档。填上 key 就能用。",
  "subtitle": "agent 的网页与文档搜索",
  "localized": { "en": { "subtitle": "Web and docs search for agents" } },
  "author": "咕咕",
  "version": "0.2.11",
  "apiVersion": 8,
  "engines": { "gugu": ">=0.2.57" },
  "entry": "settings.html",
  "icon": "icon.png",
  "permissions": {
    "capabilities": [
      "agents:tools"
    ]
  },
  "contributes": {
    "tabs": [
      {
        "name": "settings",
        "title": "全能搜索",
        "entry": "settings.html",
        "icon": "icon.png"
      }
    ],
    "mcpServers": [
      {
        "name": "omnisearch",
        "command": "node",
        "args": [
          "launch.mjs"
        ]
      }
    ]
  }
}
