{
  "id": "omnisearch",
  "name": "进阶搜索",
  "defaultLocale": "zh-CN",
  "subtitle": "agent 的网页与文档搜索",
  "author": "咕咕",
  "version": "0.4.1",
  "apiVersion": 25,
  "platforms": [
    "desktop"
  ],
  "engines": {
    "gugu": ">=0.3.1"
  },
  "entry": "settings.html",
  "icon": "icon.png",
  "permissions": {
    "capabilities": [
      "agents:tools"
    ]
  },
  "contributes": {
    "tabs": [
      {
        "name": "settings",
        "title": "进阶搜索",
        "entry": "settings.html",
        "icon": "icon.png"
      }
    ],
    "mcpServers": [
      {
        "name": "omnisearch",
        "command": "node",
        "args": [
          "launch.mjs"
        ]
      }
    ],
    "instructions": "Optional extra search once the person sets a key: omnisearch__* (web search, read a page, library docs, cited answers, GitHub). Use your own search first."
  },
  "localized": {
    "en": {
      "name": "Omnisearch",
      "subtitle": "Web and docs search for agents",
      "tabs": {
        "settings": {
          "title": "Omnisearch"
        }
      }
    }
  }
}
