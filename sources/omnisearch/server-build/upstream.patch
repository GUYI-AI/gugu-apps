+			}),
+		);
+		vi.stubGlobal('fetch', fetch_mock);
+		const { FirecrawlSearchProvider } = await import('./index.js');
+
+		await expect(
+			new FirecrawlSearchProvider().search({
+				query: 'result',
+				limit: 1,
+				include_domains: ['example.com'],
+				time_range: 'week',
