@@ -0,0 +1,125 @@
+import {
+	afterEach,
+	beforeEach,
+	describe,
+	expect,
+	it,
+	vi,
+} from 'vitest';
+
+const json_response = (body: unknown) =>
+	new Response(JSON.stringify(body), {
+		status: 200,
+		headers: { 'content-type': 'application/json' },
+	});
+
+const text_response = (body: string) =>
+	new Response(body, {
+		status: 200,
+		headers: { 'content-type': 'text/plain' },
+	});
+
+const search_body = {
+	results: [
+		{
+			id: '/reactjs/react.dev',
+			title: 'React',
+			description: 'Official React docs',
+			totalSnippets: 4305,
+			trustScore: 10,
+			benchmarkScore: 90.78,
+			versions: [],
+		},
+		{ id: '/react/react', title: 'React', versions: ['v19.2.7'] },
+	],
+};
+
+describe('Context7Provider', () => {
+	beforeEach(() => {
+		vi.resetModules();
+		vi.stubEnv('CONTEXT7_API_KEY', 'test-context7-key');
+	});
+
+	afterEach(() => {
+		vi.unstubAllEnvs();
+		vi.restoreAllMocks();
+	});
+
+	it('resolves a library name, then returns its docs with alternatives', async () => {
+		const fetch_mock = vi.fn(async (url: string) =>
+			url.includes('/libs/search')
+				? json_response(search_body)
+				: text_response('### useEffect cleanup\n\nreturn () => {}'),
+		);
+		vi.stubGlobal('fetch', fetch_mock);
+		const { Context7Provider } = await import('./index.js');
+
+		const result = await new Context7Provider().get_docs({
+			library: 'react',
+			query: 'useEffect cleanup',
+		});
+
+		expect(result.library_id).toBe('/reactjs/react.dev');
+		expect(result.library?.trust_score).toBe(10);
+		expect(result.alternatives.map((a) => a.id)).toEqual([
+			'/react/react',
+		]);
+		expect(result.alternatives[0].versions).toEqual(['v19.2.7']);
+		expect(result.content).toContain('useEffect cleanup');
+
+		const urls = fetch_mock.mock.calls.map(([url]) => String(url));
+		expect(urls[0]).toContain('libraryName=react');
+		expect(urls[1]).toContain('libraryId=%2Freactjs%2Freact.dev');
+		expect(urls[1]).toContain('type=txt');
+		const [, init] = fetch_mock.mock.calls[1] as unknown as [
+			string,
+			RequestInit,
+		];
+		expect(
+			(init.headers as Record<string, string>).Authorization,
+		).toBe('Bearer test-context7-key');
+	});
+
+	it('skips the search when library_id is given', async () => {
+		const fetch_mock = vi.fn(async () => text_response('docs'));
+		vi.stubGlobal('fetch', fetch_mock);
+		const { Context7Provider } = await import('./index.js');
+
+		const result = await new Context7Provider().get_docs({
+			library_id: '/vercel/next.js',
+			query: 'app router',
+		});
+
+		expect(fetch_mock).toHaveBeenCalledTimes(1);
+		expect(result).toMatchObject({
+			library_id: '/vercel/next.js',
+			alternatives: [],
+			content: 'docs',
+			source_provider: 'context7',
+		});
+	});
+
+	it('asks for a library when neither name nor id is given', async () => {
+		vi.stubGlobal('fetch', vi.fn());
+		const { Context7Provider } = await import('./index.js');
+
+		await expect(
+			new Context7Provider().get_docs({ query: 'anything' }),
+		).rejects.toThrow(/library/);
+	});
+
+	it('says so when no library matches', async () => {
+		vi.stubGlobal(
+			'fetch',
+			vi.fn(async () => json_response({ results: [] })),
+		);
+		const { Context7Provider } = await import('./index.js');
+
+		await expect(
+			new Context7Provider().get_docs({
+				library: 'no-such-lib',
+				query: 'x',
+			}),
+		).rejects.toThrow(/no library matching/);
+	});
+});
diff --git a/src/providers/docs/context7/index.ts b/src/providers/docs/context7/index.ts
new file mode 100644
index 0000000..14140d7
--- /dev/null
+++ b/src/providers/docs/context7/index.ts
@@ -0,0 +1,164 @@
+import * as v from 'valibot';
+import { handle_provider_error } from '../../../common/errors.js';
+import { http_json } from '../../../common/http.js';
+import { parse_provider_response } from '../../../common/provider-response.js';
+import { retry_with_backoff } from '../../../common/retry.js';
+import {
+	ErrorType,
+	LibraryDocsParams,
+	LibraryDocsProvider,
+	LibraryDocsResult,
+	LibraryMatch,
+	ProviderError,
+} from '../../../common/types.js';
+import { validate_api_key } from '../../../common/validation.js';
+import { config } from '../../../config/env.js';
+
+const context7_search_response_schema = v.object({
+	results: v.array(
+		v.object({
+			id: v.string(),
+			title: v.string(),
+			description: v.optional(v.string()),
+			totalSnippets: v.optional(v.number()),
+			trustScore: v.optional(v.number()),
+			benchmarkScore: v.optional(v.number()),
+			versions: v.optional(v.array(v.string())),
+		}),
+	),
+});
+
+const MAX_ALTERNATIVES = 4;
+
+const to_match = (
+	result: v.InferOutput<
+		typeof context7_search_response_schema
+	>['results'][number],
+): LibraryMatch => ({
+	id: result.id,
+	title: result.title,
+	description: result.description,
+	trust_score: result.trustScore,
+	benchmark_score: result.benchmarkScore,
+	total_snippets: result.totalSnippets,
+	versions: result.versions?.length ? result.versions : undefined,
+});
+
+export class Context7Provider implements LibraryDocsProvider {
+	name = 'context7';
+	description =
+		'Up-to-date documentation and code examples for programming libraries and frameworks, from Context7.';
+
+	private headers(api_key: string) {
+		return {
+			Accept: 'application/json, text/plain',
+			Authorization: `Bearer ${api_key}`,
+		};
+	}
+
+	async search_libraries(
+		library: string,
+		query: string,
+	): Promise<LibraryMatch[]> {
+		const api_key = validate_api_key(
+			config.docs.context7.api_key,
+			this.name,
+		);
+		const params = new URLSearchParams({
+			libraryName: library,
+			query,
+		});
+
+		return retry_with_backoff(async () => {
+			try {
+				const raw = await http_json(
+					this.name,
+					`${config.docs.context7.base_url}/libs/search?${params}`,
+					{
+						method: 'GET',
+						headers: this.headers(api_key),
+						signal: AbortSignal.timeout(config.docs.context7.timeout),
+					},
+				);
+				const data = parse_provider_response(
+					this.name,
+					context7_search_response_schema,
+					raw,
+				);
+				return data.results.map(to_match);
+			} catch (error) {
+				handle_provider_error(error, this.name, 'search libraries');
+			}
+		});
+	}
+
+	async get_docs(
+		params: LibraryDocsParams,
+	): Promise<LibraryDocsResult> {
+		const api_key = validate_api_key(
+			config.docs.context7.api_key,
+			this.name,
+		);
+
+		let library_id = params.library_id?.trim();
+		let library: LibraryMatch | undefined;
+		let alternatives: LibraryMatch[] = [];
+
+		if (!library_id) {
+			const name = params.library?.trim();
+			if (!name) {
+				throw new ProviderError(
+					ErrorType.INVALID_INPUT,
+					'Give library (a name such as "next.js") or library_id (such as "/vercel/next.js")',
+					this.name,
+				);
+			}
+			const matches = await this.search_libraries(name, params.query);
+			if (matches.length === 0) {
+				throw new ProviderError(
+					ErrorType.INVALID_INPUT,
+					`Context7 has no library matching "${name}"`,
+					this.name,
+				);
+			}
+			[library, ...alternatives] = matches;
+			alternatives = alternatives.slice(0, MAX_ALTERNATIVES);
+			library_id = library.id;
+		}
+
+		const query_params = new URLSearchParams({
+			libraryId: library_id,
+			query: params.query,
+			type: 'txt',
+		});
+
+		const content = await retry_with_backoff(async () => {
+			try {
+				const raw = await http_json<unknown>(
+					this.name,
+					`${config.docs.context7.base_url}/context?${query_params}`,
+					{
+						method: 'GET',
+						headers: this.headers(api_key),
+						signal: AbortSignal.timeout(config.docs.context7.timeout),
+					},
+				);
+				return typeof raw === 'string' ? raw : JSON.stringify(raw);
+			} catch (error) {
+				handle_provider_error(
+					error,
+					this.name,
+					'fetch documentation',
+				);
+			}
+		});
+
+		return {
+			library_id,
+			library,
+			alternatives,
+			content,
+			source_provider: this.name,
+		};
+	}
+}
