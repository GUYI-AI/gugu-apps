@@ -0,0 +1,110 @@
+import * as v from 'valibot';
+import { handle_provider_error } from '../../../common/errors.js';
+import {
+	make_firecrawl_request,
+	validate_firecrawl_response,
+} from '../../../common/firecrawl-utils.js';
+import { retry_with_backoff } from '../../../common/retry.js';
+import {
+	apply_search_operators,
+	build_query_with_operators,
+	parse_search_operators,
+} from '../../../common/search-operators.js';
+import {
+	BaseSearchParams,
+	SearchProvider,
+	SearchResult,
+	SearchTimeRange,
+} from '../../../common/types.js';
+import { validate_api_key } from '../../../common/validation.js';
+import { config } from '../../../config/env.js';
+
+const firecrawl_search_response_schema = v.object({
+	success: v.boolean(),
+	error: v.optional(v.string()),
+	data: v.optional(
+		v.object({
+			web: v.optional(
+				v.array(
+					v.object({
+						url: v.string(),
+						title: v.optional(v.string()),
+						description: v.optional(v.string()),
+						position: v.optional(v.number()),
+					}),
+				),
+			),
+		}),
+	),
+});
+
+const time_range_tbs: Record<SearchTimeRange, string> = {
+	day: 'qdr:d',
+	week: 'qdr:w',
+	month: 'qdr:m',
+	year: 'qdr:y',
+};
+
+export class FirecrawlSearchProvider implements SearchProvider {
+	name = 'firecrawl';
+	description =
+		'Web search through Firecrawl: Google-like results with titles, URLs and page descriptions. Supports site:/-site: via include/exclude domains and time range. Pairs with web_extract firecrawl modes to read the pages it finds.';
+
+	async search(params: BaseSearchParams): Promise<SearchResult[]> {
+		const api_key = validate_api_key(
+			config.search.firecrawl.api_key,
+			this.name,
+		);
+
+		const parsed_query = parse_search_operators(params.query);
+		const search_params = apply_search_operators(parsed_query);
+
+		const search_request = async () => {
+			try {
+				const query = build_query_with_operators(
+					search_params,
+					params.include_domains,
+					params.exclude_domains,
+				);
+
+				const body: Record<string, unknown> = {
+					query,
+					limit: params.limit ?? 10,
+					sources: ['web'],
+				};
+				if (params.time_range) {
+					body.tbs = time_range_tbs[params.time_range];
+				}
+
+				const data = await make_firecrawl_request(
+					this.name,
+					config.search.firecrawl.base_url,
+					api_key,
+					body,
+					config.search.firecrawl.timeout,
+					firecrawl_search_response_schema,
+				);
+				validate_firecrawl_response(
+					data,
+					this.name,
+					'Firecrawl search failed',
+				);
+
+				return (data.data?.web ?? []).map((result) => ({
+					title: result.title ?? result.url,
+					url: result.url,
+					snippet: result.description ?? '',
+					source_provider: this.name,
+				}));
+			} catch (error) {
+				handle_provider_error(
+					error,
+					this.name,
+					'fetch search results',
+				);
+			}
+		};
+
+		return retry_with_backoff(search_request);
+	}
+}
