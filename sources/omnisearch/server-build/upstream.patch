diff --git a/src/server/tools/library-docs.ts b/src/server/tools/library-docs.ts
new file mode 100644
index 0000000..5c31a78
--- /dev/null
+++ b/src/server/tools/library-docs.ts
@@ -0,0 +1,78 @@
+import { McpServer } from 'tmcp';
+import type { GenericSchema } from 'valibot';
+import * as v from 'valibot';
+import { Context7Provider } from '../../providers/docs/context7/index.js';
+import { library_docs_provider_definitions } from '../provider-definitions.js';
+import { ProviderRegistry } from '../provider-registry.js';
+import { handle_tool_result } from './responses.js';
+import { large_result_mode_schema } from './schemas.js';
+
+const providers = new ProviderRegistry<Context7Provider>();
+
+export const initialize_library_docs = (): boolean => {
+	providers.clear();
+	providers.register_all(library_docs_provider_definitions);
+
+	return providers.size > 0;
+};
+
+export const get_available = () => providers.names();
+
+export const get_provider_status_entries = () =>
+	providers.status_entries();
+
+export const register_library_docs = (
+	server: McpServer<GenericSchema>,
+) => {
+	if (providers.size === 0) return;
+
+	server.tool(
+		{
+			name: 'library_docs',
+			description:
+				'Up-to-date documentation and code examples for a programming library, framework or SDK (Context7). Use before writing code against an API you are not sure of. Give the library name and what you want to know; the best-matching library is picked and its most relevant snippets returned, with other candidates listed. Pass library_id (e.g. "/vercel/next.js", or a version such as "/vercel/next.js/v15.1.8") from a previous answer to pin an exact library or version.',
+			annotations: {
+				readOnlyHint: true,
+				destructiveHint: false,
+				idempotentHint: true,
+				openWorldHint: true,
+			},
+			schema: v.object({
+				query: v.pipe(
+					v.string(),
+					v.minLength(1, 'Query cannot be empty'),
+					v.regex(/\S/, 'Query cannot be empty'),
+					v.description(
+						'What you want to know, e.g. "useEffect cleanup" or "configure middleware"',
+					),
+				),
+				library: v.optional(
+					v.pipe(
+						v.string(),
+						v.description(
+							'Library name, e.g. "react", "next.js", "valibot" (when library_id is not given)',
+						),
+					),
+				),
+				library_id: v.optional(
+					v.pipe(
+						v.string(),
+						v.description(
+							'Exact Context7 library id from a previous answer, e.g. "/vercel/next.js"',
+						),
+					),
+				),
+				large_result_mode: large_result_mode_schema,
+			}),
+		},
+		async ({ query, library, library_id, large_result_mode }) =>
+			handle_tool_result(
+				'library_docs',
+				async () =>
+					providers
+						.require('context7', 'library_docs')
+						.get_docs({ query, library, library_id }),
+				{ large_result_mode },
+			),
+	);
+};
