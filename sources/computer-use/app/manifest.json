{
  "id": "computer-use",
  "name": "Computer Use",
  "defaultLocale": "en",
  "subtitle": "Native app control for agents",
  "version": "0.4.0",
  "icon": "icon.png",
  "apiVersion": 25,
  "platforms": [
    "desktop"
  ],
  "engines": {
    "gugu": ">=0.3.1"
  },
  "author": "Gugu",
  "categories": [
    "productivity"
  ],
  "repository": "https://github.com/shuxueshuxue/gugu-apps",
  "license": "MIT",
  "permissions": {
    "capabilities": [
      "agents:tools"
    ]
  },
  "contributes": {
    "tabs": [
      {
        "name": "settings",
        "title": "Settings",
        "hostPage": "settings"
      },
      {
        "name": "preview",
        "title": "电脑",
        "entry": "preview.html",
        "icon": "icon.png",
        "perSession": true
      }
    ],
    "mcpServers": [
      {
        "name": "computer-use",
        "host": "computer-use"
      }
    ],
    "instructions": "Operates this computer's desktop apps: device_actions with group computer, then device_call; each task's Computer tab shows the steps."
  },
  "examples": [
    "Which desktop apps are open now?",
    "Do this for me in that app"
  ],
  "localized": {
    "zh-CN": {
      "subtitle": "agent 操作本机原生应用",
      "examples": [
        "查看当前打开的原生应用",
        "帮我在这个应用里完成操作"
      ]
    }
  }
}
