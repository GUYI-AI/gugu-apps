{
  "id": "computer-use",
  "name": "Computer Use",
  "description": "Let agents see and operate native apps on this computer. Each task shows its agent's screen in its own Computer tab.",
  "version": "0.2.0",
  "icon": "icon.png",
  "apiVersion": 5,
  "engines": { "gugu": ">=0.2.57" },
  "author": "Gugu",
  "categories": ["productivity"],
  "repository": "https://github.com/shuxueshuxue/gugu-apps",
  "license": "MIT",
  "localized": { "zh-CN": { "description": "让 Agent 查看和操作这台电脑上的原生应用；每个任务的操作画面在它自己的「电脑」页签里。" } },
  "permissions": { "capabilities": ["agents:tools"] },
  "contributes": {
    "tabs": [
      { "name": "settings", "title": "Settings", "hostPage": "settings" },
      { "name": "preview", "title": "电脑", "entry": "preview.html", "icon": "icon.png", "perSession": true }
    ],
    "mcpServers": [{ "name": "computer-use", "host": "computer-use" }]
  },
  "examples": ["查看当前打开的原生应用", "帮我在这个应用里完成操作"]
}
