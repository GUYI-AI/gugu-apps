{
  "id": "computer-use",
  "name": "Computer Use",
  "defaultLocale": "en",
  "subtitle": "Native app control for agents",
  "version": "0.5.0",
  "icon": "icon.png",
  "apiVersion": 30,
  "platforms": [
    "desktop"
  ],
  "engines": {
    "gugu": ">=0.3.1"
  },
  "author": "Gugu",
  "categories": [
    "productivity"
  ],
  "repository": "https://github.com/GUYI-AI/gugu-apps",
  "license": "MIT",
  "permissions": {
    "capabilities": [
      "agents:tools"
    ]
  },
  "contributes": {
    "tabs": [
      {
        "name": "settings",
        "title": "Settings",
        "entry": "settings.html"
      },
      {
        "name": "preview",
        "title": "电脑",
        "entry": "preview.html",
        "icon": "icon.png",
        "perSession": true
      }
    ],
    "mcpServers": [
      {
        "name": "computer-use",
        "command": "node",
        "args": [
          "program/server.mjs"
        ]
      }
    ],
    "instructions": "Use Browser Use for webpages; use these tools for native desktop apps. The Computer tab shows the real window; blockers return for the conversation."
  },
  "examples": [
    "Which desktop apps are open now?",
    "Do this for me in that app"
  ],
  "localized": {
    "zh-CN": {
      "subtitle": "agent 操作本机原生应用",
      "examples": [
        "查看当前打开的原生应用",
        "帮我在这个应用里完成操作"
      ]
    }
  }
}
