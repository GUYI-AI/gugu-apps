{
  "id": "paper-club",
  "name": "论文共读",
  "defaultLocale": "zh-CN",
  "subtitle": "论文共读、划线讨论与学习卡",
  "author": "咕咕",
  "version": "0.5.0",
  "apiVersion": 25,
  "platforms": [
    "desktop",
    "phone"
  ],
  "engines": {
    "gugu": ">=0.3.1"
  },
  "entry": "shelf.html",
  "icon": "icon.png",
  "categories": [
    "research"
  ],
  "license": "Apache-2.0",
  "examples": [
    "总结这篇论文，并在关键段落上划线",
    "给这篇论文出 10 张学习卡片",
    "找出这篇论文的代码并复现主实验"
  ],
  "permissions": {
    "capabilities": [
      "files:read",
      "files:write",
      "chat:relay",
      "chat:read",
      "agents:control",
      "agents:tools"
    ],
    "network": [
      "arxiv.org",
      "export.arxiv.org",
      "api.semanticscholar.org",
      "api.openalex.org"
    ]
  },
  "contributes": {
    "tabs": [
      {
        "name": "shelf",
        "title": "论文共读",
        "icon": "icon.png",
        "entry": "shelf.html"
      },
      {
        "name": "reader",
        "title": "论文共读",
        "icon": "icon.png",
        "entry": "reader.html",
        "opensFiles": {
          "chat": [
            ".pdf",
            ".paper.json"
          ],
          "session": [
            ".pdf"
          ]
        },
        "fileIcons": {
          ".pdf": "pdf.png",
          ".paper.json": "pdf.png"
        }
      }
    ],
    "mcpServers": [
      {
        "tools": "tools.js"
      }
    ],
    "skills": "skills",
    "instructions": "Read skill paper-club first. paper-club__read, evidence and cite answer from a paper with links back to the passage; add_cards, import_paper."
  },
  "localized": {
    "en": {
      "name": "Paper Club",
      "subtitle": "Read papers together in a chat"
    }
  }
}
