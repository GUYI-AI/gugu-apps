{
  "id": "prompts",
  "name": "提示词管理",
  "defaultLocale": "zh-CN",
  "subtitle": "让 agent 读取和整理你资源库里的提示词",
  "author": "咕咕",
  "license": "MIT",
  "icon": "icon.png",
  "version": "0.2.0",
