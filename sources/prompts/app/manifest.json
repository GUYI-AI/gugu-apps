    "hostLinks": ["library:prompts"]
  },
  "examples": ["把这段存成提示词", "我的提示词里有哪些重复的？"],
  "localized": {
    "en": {
      "name": "Prompts",
      "subtitle": "Agents manage Library prompts",
      "examples": ["Save this as a prompt", "Which of my prompts overlap?"]
    }
  }
