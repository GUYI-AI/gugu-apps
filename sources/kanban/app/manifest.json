{
  "id": "kanban",
  "name": "协作看板",
  "defaultLocale": "zh-CN",
  "subtitle": "人和 agent 共用的看板",
  "author": "咕咕",
  "version": "1.6.1",
  "apiVersion": 26,
  "platforms": [
    "desktop",
    "phone"
  ],
  "engines": {
    "gugu": ">=0.3.1"
  },
  "entry": "board.html",
  "icon": "icon.png",
  "categories": [
    "productivity"
  ],
  "background": {
    "entry": "background.html"
  },
  "permissions": {
    "capabilities": [
      "files:read",
      "files:write",
      "agents:read:all-machines",
      "agents:control:all-machines",
      "agents:tools"
    ]
  },
  "contributes": {
    "tabs": [
      {
        "name": "board",
        "title": "协作看板",
        "entry": "board.html",
        "toolbar": [
          {
            "id": "new",
            "title": "新建卡片"
          }
        ]
      },
      {
        "name": "file",
        "title": "协作看板",
        "entry": "board.html",
        "opensFiles": {
          "chat": [
            ".board.json"
          ]
        },
        "chatFile": "协作看板.board.json",
        "toolbar": [
          {
            "id": "new",
            "title": "新建卡片"
          }
        ]
      },
      {
        "name": "fleet",
        "title": "舰队",
        "entry": "fleet.html",
        "widget": {
          "height": 120
        }
      }
    ],
    "mcpServers": [
      {
        "tools": "tools.js"
      }
    ],
    "skills": "skills",
    "instructions": "Read skill kanban first. kanban__list shows who holds each card and what waits on the owner; claim, update, ask, move, comment cards. Fleets: see the skill."
  },
  "examples": [
    "把这件事添加到我的看板",
    "群看板上有哪些卡片在等人处理？",
    "舰队现在有哪些车道在等我拍板？"
  ],
  "license": "MIT",
  "localized": {
    "en": {
      "name": "Teamboard",
      "subtitle": "A board for people and agents",
      "tabs": {
        "board": {
          "title": "Teamboard",
          "toolbar": {
            "new": "New card"
          }
        },
        "file": {
          "title": "Teamboard",
          "toolbar": {
            "new": "New card"
          }
        },
        "fleet": {
          "title": "Fleet"
        }
      }
    }
  }
}
