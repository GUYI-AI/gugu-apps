{
  "id": "kanban",
  "name": "协作看板",
  "defaultLocale": "zh-CN",
  "subtitle": "人和 agent 共用的看板",
  "author": "咕咕",
  "version": "1.3.0",
  "apiVersion": 24,
  "platforms": [
    "desktop",
    "phone"
  ],
  "engines": {
    "gugu": ">=0.3.1"
  },
  "entry": "board.html",
  "icon": "icon.png",
  "categories": [
    "productivity"
  ],
  "background": {
    "entry": "background.html"
  },
  "permissions": {
    "capabilities": [
      "files:read",
      "files:write",
      "agents:read:all-machines",
      "agents:control",
      "agents:tools"
    ]
  },
  "contributes": {
    "tabs": [
      {
        "name": "board",
        "title": "协作看板",
        "entry": "board.html",
        "toolbar": [
          {
            "id": "new",
            "title": "新建卡片"
          }
        ]
      },
      {
        "name": "file",
        "title": "协作看板",
        "entry": "board.html",
        "opensFiles": {
          "chat": [
            ".board.json"
          ]
        },
        "chatFile": "协作看板.board.json",
        "toolbar": [
          {
            "id": "new",
            "title": "新建卡片"
          }
        ]
      }
    ],
    "mcpServers": [
      {
        "tools": "tools.js"
      }
    ],
    "skills": "skills",
    "instructions": "Read skill kanban first. kanban__list, claim, update, move and comment work cards on this computer's board or a chat's .board.json."
  },
  "examples": [
    "把这件事添加到我的看板",
    "群看板上有哪些卡片在等人处理？"
  ],
  "license": "MIT",
  "localized": {
    "en": {
      "name": "Teamboard",
      "subtitle": "A board for people and agents"
    }
  }
}
