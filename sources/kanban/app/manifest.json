{
  "id": "kanban",
  "name": "协作看板",
  "defaultLocale": "zh-CN",
  "subtitle": "人和 agent 共用的看板",
  "author": "咕咕",
  "version": "2.0.2",
  "apiVersion": 26,
  "platforms": [
    "desktop",
    "phone"
  ],
  "engines": {
    "gugu": ">=0.3.1"
  },
  "entry": "board.html",
  "icon": "icon.png",
  "categories": [
    "productivity"
  ],
  "background": {
    "entry": "background.html"
  },
  "permissions": {
    "capabilities": [
      "files:read",
      "files:write",
      "agents:read:all-machines",
      "agents:control:all-machines",
      "agents:tools",
      "chat:relay"
    ]
  },
  "contributes": {
    "tabs": [
      {
        "name": "board",
        "title": "协作看板",
        "entry": "board.html"
      },
      {
        "name": "file",
        "title": "协作看板",
        "entry": "board.html",
        "opensFiles": {
          "chat": [
            ".board.json"
          ]
        },
        "chatFile": "协作看板.board.json"
      },
      {
        "name": "fleet",
        "title": "看板摘要",
        "entry": "fleet.html",
        "widget": {
          "height": 120
        }
      }
    ],
    "mcpServers": [
      {
        "tools": "tools.js"
      }
    ],
    "skills": "skills",
    "instructions": "Read skill kanban first. kanban__board reads a board; kanban__set is its one write: add or take a card, wait, ask the owner, tick checks, finish, name a lead."
  },
  "examples": [
    "把这件事记到我的看板上",
    "群看板上有什么在等我？",
    "接手看板上那张没人接的卡"
  ],
  "license": "MIT",
  "localized": {
    "en": {
      "name": "Teamboard",
      "subtitle": "A board for people and agents",
      "tabs": {
        "board": {
          "title": "Teamboard"
        },
        "file": {
          "title": "Teamboard"
        },
        "fleet": {
          "title": "Board summary"
        }
      },
      "examples": [
        "Put this on my board",
        "What on the group's board is waiting on me?",
        "Take the unclaimed card on the board"
      ]
    }
  }
}
